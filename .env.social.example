# Social Login Configuration
# Ajoutez ces lignes à votre fichier .env

# Google OAuth
GOOGLE_CLIENT_ID=votre_google_client_id
GOOGLE_CLIENT_SECRET=votre_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/login/google/callback

# Facebook OAuth
FACEBOOK_CLIENT_ID=votre_facebook_client_id
FACEBOOK_CLIENT_SECRET=votre_facebook_client_secret
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8000/login/facebook/callback

# Instructions pour obtenir les clés :
#
# 1. Google OAuth :
#    - Allez sur https://console.cloud.google.com/
#    - Créez un nouveau projet ou sélectionnez-en un existant
#    - Activez "Google+ API" ou "People API"
#    - Allez dans "Credentials" > "Create Credentials" > "OAuth client ID"
#    - Choisissez "Web application"
#    - Ajoutez "http://127.0.0.1:8000/login/google/callback" dans "Authorized redirect URIs"
#    - Copiez le Client ID et Client Secret
#
# 2. Facebook OAuth :
#    - Allez sur https://developers.facebook.com/
#    - Créez une nouvelle application ou sélectionnez-en une existante
#    - Allez dans "Products" > "Facebook Login" > "Settings"
#    - Ajoutez "http://127.0.0.1:8000/login/facebook/callback" dans "Valid OAuth Redirect URIs"
#    - Copiez l'App ID et l'App Secret
